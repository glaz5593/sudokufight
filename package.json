{
  "name": "sudoku-fight",
  "version": "0.1.0",
  "private": true,
  "description": "Sudoku Fight: a real-time competitive sudoku for 1-4 players.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --selectProjects engine",
    "mobile": "npm run start -w @sudoku-fight/mobile --",
    "android": "npm run android -w @sudoku-fight/mobile --",
    "android:reverse": "adb reverse tcp:2567 tcp:2567 && adb reverse tcp:8081 tcp:8081",
    "server": "cross-env NODE_ENV=development npm run dev -w @sudoku-fight/server",
    "dev:lan": "node scripts/dev-lan.mjs",
    "server:start": "npm run start -w @sudoku-fight/server",
    "seed": "npm run seed -w @sudoku-fight/server --",
    "db:seed-puzzles": "npm run db:seed-puzzles -w @sudoku-fight/server --",
    "fake-client": "npm run fake-client -w @sudoku-fight/server --",
    "admin:dev": "npm run dev -w @sudoku-fight/admin",
    "admin:build": "npm run build -w @sudoku-fight/admin",
    "typecheck": "npm run routes:types -w @sudoku-fight/mobile && tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/i18n-check.mjs",
    "licenses": "node scripts/licenses.mjs",
    "verify": "npm run lint && npm run typecheck && npm run i18n:check && npm test",
    "puzzles:import": "npm run puzzles:import -w @sudoku-fight/engine --",
    "puzzles:generate": "npm run puzzles:generate -w @sudoku-fight/engine --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "29.5.14",
    "@types/node": "~24.19.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "globals": "^16.5.0",
    "jest": "~29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@types/react": "~19.2.4"
  }
}
