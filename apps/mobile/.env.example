# Copy to .env.local (not committed).
# Emulator: keep localhost and run `adb reverse tcp:2567 tcp:2567`.
# Phone on the same Wi-Fi: the computer's LAN IP.
EXPO_PUBLIC_SERVER_HOST=localhost
EXPO_PUBLIC_SERVER_PORT=2567
EXPO_PUBLIC_SERVER_SECURE=false
# The legal pages (privacy policy, terms of use). Unset → the game server's /legal/… (the usual case).
# EXPO_PUBLIC_LEGAL_BASE_URL=https://example.com/legal
