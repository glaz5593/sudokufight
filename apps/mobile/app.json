{
  "expo": {
    "name": "Sudoku Fight",
    "slug": "sudoku-fight",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sudokufight",
    "userInterfaceStyle": "dark",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "bundleIdentifier": "com.mosheg.sudokufight",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mosheg.sudokufight",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#0f1218"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "../../node_modules/@expo-google-fonts/rubik/400Regular/Rubik_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/rubik/500Medium/Rubik_500Medium.ttf",
            "../../node_modules/@expo-google-fonts/rubik/600SemiBold/Rubik_600SemiBold.ttf",
            "../../node_modules/@expo-google-fonts/rubik/700Bold/Rubik_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/teko/500Medium/Teko_500Medium.ttf",
            "../../node_modules/@expo-google-fonts/teko/600SemiBold/Teko_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-mark.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "backgroundColor": "#0f1218"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0f1218",
    "extra": {
      "supportsRTL": true
    }
  }
}
