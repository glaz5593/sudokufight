# Server settings (src/config.ts reads them; bad values stop the server at start with a clear message, except
# the admin site's Google sign-in settings, which only turn that sign-in off).
# For local overrides, copy this file to apps/server/.env (gitignored) — it is loaded on start.
# Never put real secrets in this file: production sets them in the host's secrets (e.g. `fly secrets set`).

# development | test | production. `npm run server` sets development.
NODE_ENV=development

# HTTP and WebSocket port.
PORT=2567

# Postgres connection string (production). Unset → PGlite, the in-process Postgres (no install).
# Production refuses to start without it, unless PGLITE_DIR is set on purpose.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/sudoku_fight

# PGlite data folder when DATABASE_URL is unset. Default apps/server/.data/pglite (gitignored);
# `memory` keeps nothing between runs (the default under NODE_ENV=test).
# PGLITE_DIR=

# The admin site (spec §27.3) signs in with Google and/or a password; with neither, it stays off (its API answers
# 503 "disabled"). The start-up line says which methods are on.
#
# Google sign-in (the real servers): on when FIREBASE_PROJECT_ID (below), FIREBASE_WEB_API_KEY and ADMIN_EMAILS
# are all set; part of them, or a bad value among them (an entry that is not an address, a key of the wrong
# shape) → off, with a warning saying what is missing or wrong. The server still starts: a typo here never stops
# the game. Setup: docs/FIREBASE-SETUP.md, "Google sign-in for the admin site".
# - ADMIN_EMAILS: the Google accounts that may sign in, separated by commas, semicolons or spaces (any case).
#   Only these; a Google account must also have a verified address. Never write the real list in the repo.
# - FIREBASE_WEB_API_KEY and FIREBASE_WEB_APP_ID: the "Sudoku Fight Admin" web app's apiKey ("AIza…") and appId
#   (1:<number>:web:<hex>; optional). Public by design (the admin page gets them), but set as Fly secrets so
#   they stay out of the repo.
# ADMIN_EMAILS=you@example.com, other@example.com
# FIREBASE_WEB_API_KEY=
# FIREBASE_WEB_APP_ID=

# The admin password, optional.
# - production: at least 8 characters, and not the dev password, or password sign-in stays off.
# - development with PGlite: unset → the fixed dev password "sudoku-admin-dev" (with a warning).
# ADMIN_PASSWORD=

# Signs the admin session cookie; at least 32 characters (e.g. `openssl rand -hex 32`). Optional.
# Unset → a random one per start, so admins sign in again after a restart or a deploy.
# Set → a real secret: with Google sign-in only, it alone signs the sessions, so whoever knows it can make one
# for any address on ADMIN_EMAILS. Its own value on each server; never in the repo or a chat.
# ADMIN_SESSION_SECRET=

# The admin site counts days in this IANA time zone.
ADMIN_TZ=Asia/Jerusalem

# Proxies to trust for the client's address (rate limits are per IP; an IPv6 /64 counts as one address).
# Behind a proxy this is required: without it every client shares the proxy's address and one limit.
# A hop count (Fly.io: 1), addresses/subnets ("loopback, 10.0.0.0/8"), true (all: only behind a proxy
# that overwrites X-Forwarded-For), or false (default: no proxy).
# TRUST_PROXY=1

# Accounts (stage 8): the Firebase project whose ID tokens the server accepts (Firebase console → Project
# settings → Project ID, e.g. sudoku-fight-1a2b3). Not a secret: the server checks tokens with Google's public
# keys and needs no service account.
# - production: unset → the account routes (/v1/names/available, /v1/users, /v1/me) answer 503 "disabled".
# - development and tests: development tokens ("dev:<uid>", from builds without Firebase) work with or
#   without it; never in production.
# - The admin site's Google sign-in checks its tokens against this project too (see ADMIN_EMAILS above).
# FIREBASE_PROJECT_ID=

# Ratings [D7]: B (default) one rating per game type (fast, normal, hard); A one per game type and player
# count (fast-2p … hard-4p). New accounts get 1200, provisional, in every key of the option [D23].
RATING_OPTION=B

# Anomaly flags (spec §21): after a ranked game, a player whose average think time over this many consecutive
# correct moves is below this many ms gets a cheat_flags row, shown on the user's page in the admin site.
# For review only: nothing is blocked in V1.
CHEAT_FAST_THINK_MS=1200
CHEAT_FAST_THINK_MOVES=20

# Deleting an account (DELETE /v1/me) wants a sign-in (the Firebase ID token's auth_time) at most this many ms
# ago, else 401 "reauthRequired": the app asks for the password again, then sends a fresh token. Default 300000
# (5 minutes, Firebase's own rule for deleting a user); 1000 to 86400000.
# ACCOUNT_DELETE_MAX_AUTH_AGE_MS=300000

# Ranked games need a verified email [D22]: the ranked queue refuses an ID token whose email is not verified
# ("emailNotVerified"; the app then sends the player to verify it). true (default) or false. Development tokens
# count as verified (they work only outside production).
# RANKED_REQUIRES_VERIFIED_EMAIL=true

# Progress (stage 12, spec §15) [D41]: practice games are played on the phone and only reported for their XP,
# so the server can't check them; this caps the XP practice may earn per UTC day (of the game's end).
# Default 1500 (about 25 bot games a day); 0 gives practice no XP at all.
# PRACTICE_XP_DAILY_CAP=1500

# The link the leaderboard's friends tab shares from its "invite friends" button [D27] (http or https).
# Unset → no button.
# INVITE_URL=https://example.com/invite

# Error reports (stage 14, src/monitoring): Sentry's DSN for the server's project (Sentry → Project settings →
# Client Keys (DSN)). Unset → no reports, and the Sentry SDK is never loaded. Production: `fly secrets set`.
# What is sent has no personal data: no headers, cookies, bodies, query strings or IP addresses, and emails and
# tokens are scrubbed from messages (src/monitoring/redact.ts).
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project id>

# Which deployment the reports come from. Default NODE_ENV; staging and production both run NODE_ENV=production,
# so fly.toml sets "staging" and fly.production.toml "production".
# SENTRY_ENVIRONMENT=staging

# The release name. Default sudoku-fight-server@<version>, plus +<GIT_SHA> when set
# (`fly deploy --env GIT_SHA=$(git rev-parse --short HEAD)`), else + Fly's deployment id (FLY_IMAGE_REF).
# SENTRY_RELEASE=
# GIT_SHA=

# The share of HTTP requests traced (0–1). Default 0.05; 0 turns tracing off. Health checks, the admin site, the
# legal pages and the WebSocket games are never traced.
# SENTRY_TRACES_SAMPLE_RATE=0.05

# The legal pages (stage 14, src/legal): GET /legal/privacy, /legal/terms and /legal/delete-account (?lang=he|en).
# The privacy contact address and who runs the game, shown on every page. Unset → visible placeholders and a
# "draft" note (production warns at start). Both must be set before the stores get the URLs (docs/store/).
# LEGAL_CONTACT_EMAIL=privacy@example.com
# LEGAL_OPERATOR_NAME=

# Playing with friends (1.0.4, src/friends; docs/handoff/2026-10-19/friends-room.md §5, §6). None of it is a secret:
# the files these settings make are public by design.
#
# Android App Links: the SHA-256 fingerprint of every key that signs the app this server's room links
# (https://<server>/r/123456) should open, separated by commas, semicolons or spaces, with or without colons (any
# case). GET /.well-known/assetlinks.json lists them; unset → it answers 404, and the links open in the browser page.
# - staging (fly.toml [env]): React Native's debug key, which signs the APKs of `npm run apk`, and EAS's key
#   (`eas credentials` → Android → the keystore's SHA256 Fingerprint).
# - production (fly.production.toml [env]): EAS's key, and Google Play's app signing key (Play Console → Test and
#   release → App integrity → App signing). Never the debug key.
# The debug key is public, the same in every React Native project (keytool -list -v -keystore
# apps/mobile/android/app/debug.keystore -alias androiddebugkey -storepass android). Its SHA-256 is
# FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C.
# Anyone can sign an APK named com.mosheg.sudokufight with it, so NODE_ENV=production refuses to start with it in the
# list, unless ANDROID_APP_LINK_ALLOW_DEBUG_KEY=true says this is a test server (staging only; it warns at start).
# ANDROID_APP_LINK_SHA256=FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C
# ANDROID_APP_LINK_ALLOW_DEBUG_KEY=false

# iOS universal links, once there is an iOS build: "<Team ID>.com.mosheg.sudokufight" (the Team ID: Apple Developer →
# Membership, 10 letters and digits). GET /.well-known/apple-app-site-association serves it; unset → 404.
# IOS_APP_ID=ABCDE12345.com.mosheg.sudokufight

# The store pages a room link's browser page offers (https). Unset → the page says the app is still in testing,
# and how to type the code in it.
# STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.mosheg.sudokufight
# STORE_URL_IOS=https://apps.apple.com/app/id0000000000

# Rate limits of POST /v1/rooms and /v1/rooms/join [D86]: rooms one account may open in an hour (default 10), tries
# to join a room per account in 10 minutes (default 20), and the same per IP address (default 60; an IPv6 /64 counts
# as one). Past one: 429 "tooManyRequests" with Retry-After.
# FRIENDS_CREATES_PER_HOUR=10
# FRIENDS_JOINS_PER_10_MIN=20
# FRIENDS_JOINS_PER_10_MIN_PER_IP=60

# The stealth bot (src/stealth; docs/handoff/2026-10-19/stealth-bot.md §4, §8) [D90–D99]: when a ranked two-player
# search finds nobody, the server may seat a bot that plays like a person, at the player's own pace, rated as usual.
# OFF in every environment. Switching it on in staging waits for Moshe's word [D90]; production after that.
# STEALTH_BOT_ENABLED is the master switch: false (default) → the feature does not exist on this server, and
# matchmaking is as before it. true → the admin site's switch decides, with no restart (it starts off: an admin turns
# it on). A restart ends every ranked game being played, so never toggle this variable to turn the bot off; use the
# admin switch.
# STEALTH_BOT_ENABLED=false
# The queues it may enter: two-player queues only [D94].
# STEALTH_BOT_QUEUES=fast-2p,normal-2p,hard-2p
# The wait drawn when a search starts ("<min>-<max>" ms): the bot comes only after it, and only while nobody the
# player could meet is searching [D94].
# STEALTH_BOT_AFTER_MS=8000-20000
# [D95] While it is on and a persona is within the player's reach, `searching` does not say "nobody else is
# searching" (the app shows the range bar). false: the notice as before, then "found".
# STEALTH_BOT_HIDE_NOBODY=true
# The most personas (the bot's made-up accounts) the server makes, on demand [D91].
# STEALTH_PERSONA_POOL_MAX=1000
# The key of the bot's private seed (HMAC with the game id; 32+ characters). Unset → random at each start, which is
# enough to keep it private; set it (a secret: fly secrets) to replay a reported game's bot later.
# STEALTH_BOT_SECRET=
